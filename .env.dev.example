# Umgebungsvariablen für lokale Entwicklung
# Kopiere diese Datei zu .env.dev und passe sie an

NODE_ENV=development
APP_NAME=FreeWorldFirst Collector
APP_PORT=8100

# Datenbank für Docker
# Für Docker: DB_HOST=postgres
# Für lokale Installation: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fwf_collector_dev
DB_USER=fwf_user
DB_PASSWORD=dev_password_change_me

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production_12345
JWT_EXPIRY=24h

# CORS (mehrere Origins mit Komma trennen)
CORS_ORIGIN=http://localhost:3000,http://localhost:8181

# API URLs
API_URL=http://localhost:8100/api
FRONTEND_URL=http://localhost:3000
